{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Monster",
  "description": "Terratopia monster definition (src/GameEngine/DataClasses/Monster.cs)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "monsterId",
    "name",
    "hpBase",
    "hpPerLevel",
    "powerBase",
    "powerPerLevel",
    "defenseBase",
    "defensePerLevel",
    "speedBase",
    "speedBasePerLevel",
    "canUseFightAction"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1,
      "description": "Schema version this file was written against. Managed by the GameData Editor — do not hand-edit."
    },
    "monsterId": {
      "type": "string",
      "description": "Unique identifier for this monster."
    },
    "name": {
      "type": "string",
      "description": "Display name."
    },
    "hpBase": {
      "type": "integer"
    },
    "hpPerLevel": {
      "type": "integer"
    },
    "powerBase": {
      "type": "integer"
    },
    "powerPerLevel": {
      "type": "integer"
    },
    "defenseBase": {
      "type": "integer"
    },
    "defensePerLevel": {
      "type": "integer"
    },
    "speedBase": {
      "type": "integer"
    },
    "speedBasePerLevel": {
      "type": "integer"
    },
    "monsterActionIds": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true,
      "description": "Ids of monster actions (GameData/MonsterActions) this monster can use."
    },
    "passives": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "LivingDead"
        ]
      },
      "uniqueItems": true,
      "description": "Names of passive classes (src/CombatEngine/Passives) applied to this monster, e.g. \"LivingDead\". Hand-maintained against PassiveRegistry.cs's registered PassiveName constants — keep in sync by hand."
    },
    "canUseFightAction": {
      "type": "boolean"
    }
  }
}
