{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MonsterAction",
  "description": "Terratopia monster action definition (src/GameEngine/DataClasses/MonsterAction.cs)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "monsterActionId",
    "name",
    "jobClass",
    "tpCost",
    "tier",
    "description",
    "validTargets",
    "livingOrDead"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 2,
      "description": "Schema version this file was written against. Managed by the GameData Editor — do not hand-edit."
    },
    "monsterActionId": {
      "type": "string",
      "description": "Unique identifier for this monster action."
    },
    "name": {
      "type": "string",
      "description": "Display name."
    },
    "jobClass": {
      "type": "string",
      "description": "Job class this action belongs to, e.g. \"BlackMage\", \"WhiteMage\", \"Rogue\", \"Fighter\"."
    },
    "tpCost": {
      "type": "integer"
    },
    "tier": {
      "type": "integer"
    },
    "description": {
      "type": "string"
    },
    "keywords": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["Teamwork", "Engage", "Cruel", "Empowered", "Stoic", "Growth"]
      },
      "uniqueItems": true,
      "description": "Names of keyword classes (src/CombatEngine/Keywords) applied to this action, e.g. \"Engage\". Hand-maintained against PowerKeywordRegistry.cs's registered KeywordName constants — keep in sync by hand."
    },
    "traits": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "numTargets": {
      "type": "integer",
      "default": 1
    },
    "targetingType": {
      "type": "string",
      "enum": ["Choose", "Random", "All", "Self"],
      "default": "Choose"
    },
    "validTargets": {
      "type": "string",
      "enum": ["Allies", "Enemies", "Both"]
    },
    "livingOrDead": {
      "type": "string",
      "enum": ["Living", "Dead", "Both"]
    },
    "targetStatuses": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "userStatuses": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "directEffects": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["effectType"],
        "properties": {
          "effectType": {
            "type": "string",
            "enum": ["Damage", "Heal"]
          },
          "element": {
            "type": "string",
            "enum": ["Fire", "Ice", "Lightning", "Void"]
          },
          "calcType": {
            "type": "string",
            "enum": ["StandardFormula", "FixedPower"],
            "default": "StandardFormula"
          },
          "powerFactor": {
            "type": "number",
            "default": 1.0
          }
        }
      },
      "uniqueItems": true
    }
  }
}
