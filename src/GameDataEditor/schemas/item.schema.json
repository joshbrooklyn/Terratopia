{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Item",
  "description": "Terratopia item definition (src/GameEngine/DataClasses/Item.cs).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "itemId",
    "name",
    "rarity",
    "description",
    "validTargets",
    "livingOrDead"
  ],
  "properties": {
    "itemId": {
      "type": "string",
      "description": "Unique identifier for this item."
    },
    "name": {
      "type": "string",
      "description": "Display name."
    },
    "rarity": {
      "type": "integer"
    },
    "description": {
      "type": "string"
    },
    "numAttacks": {
      "type": "integer",
      "default": 1
    },
    "keywords": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "traits": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "targetingType": {
      "type": "string",
      "enum": ["Choose", "Random", "All", "Self"],
      "default": "Choose"
    },
    "validTargets": {
      "type": "string",
      "enum": ["Allies", "Enemies", "Both"]
    },
    "livingOrDead": {
      "type": "string",
      "enum": ["Living", "Dead", "Both"]
    },
    "allowMultipleAttackOnSameTarget": {
      "type": "boolean"
    },
    "targetStatuses": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "userStatuses": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "directEffects": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["effectType"],
        "properties": {
          "effectType": {
            "type": "string",
            "enum": ["Damage", "Heal"]
          },
          "element": {
            "type": "string",
            "enum": ["Fire", "Ice", "Lightning", "Void"]
          },
          "calcType": {
            "type": "string",
            "enum": ["StandardFormula", "FixedPower"],
            "default": "StandardFormula"
          },
          "powerFactor": {
            "type": "number",
            "default": 1.0
          }
        }
      }
    }
  }
}
